---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="home-intro">
    <p class="eyebrow">PERSONAL NOTES</p>
    <h1>把想法写下来，<br /><em>让时间留下痕迹。</em></h1>
    <p class="intro-copy">这里记录技术、阅读、工作，以及生活里值得反复想一想的事情。</p>
  </section>
  <section class="posts-section" aria-labelledby="posts-heading">
    <div class="section-heading"><h2 id="posts-heading">最新文章</h2><label class="search-box" for="post-search"><span aria-hidden="true">⌕</span><input id="post-search" type="search" placeholder="搜索文章" autocomplete="off" /></label></div>
    <div class="post-list" id="post-list">
      {posts.map((post) => <article class="post-card" data-search={`${post.data.title} ${post.data.description ?? ''} ${post.data.tags.join(' ')}`}>
        <div class="post-card-meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN').replaceAll('/', '.')}</time>{post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}</div>
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        {post.data.description && <p>{post.data.description}</p>}
        <a class="read-link" href={`/blog/${post.id}/`}>阅读全文 <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
    <p class="empty-state" id="no-results" hidden>没有找到匹配的文章。</p>
  </section>
  <script is:inline>
    const input = document.getElementById('post-search');
    const cards = document.querySelectorAll('.post-card');
    const empty = document.getElementById('no-results');
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => { const matches = card.dataset.search.toLowerCase().includes(query); card.hidden = !matches; if (matches) visible += 1; });
      if (empty) empty.hidden = visible !== 0;
    });
  </script>
</BaseLayout>
